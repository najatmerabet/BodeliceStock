generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produit {
  id       Int       @id @default(autoincrement())
  nom      String    @unique
  prix     Decimal   @db.Decimal(10, 2)
  stock    Decimal   @default(0) @db.Decimal(10, 2)
  lignesBl LigneBl[]

  @@map("produits")
}

model Client {
  id            Int            @id @default(autoincrement())
  nom           String
  telephone     String?
  adresse       String?
  bonsLivraison BonLivraison[]
  factures      Facture[]

  @@map("clients")
}

model BonLivraison {
  id       Int       @id @default(autoincrement())
  numero   String    @unique
  clientId Int       @map("client_id")
  date     DateTime  @default(now())
  total    Decimal   @default(0) @db.Decimal(10, 2)
  client   Client    @relation(fields: [clientId], references: [id])
  lignes   LigneBl[]

  @@map("bons_livraison")
}

model LigneBl {
  id           Int          @id @default(autoincrement())
  blId         Int          @map("bl_id")
  produitId    Int          @map("produit_id")
  quantite     Decimal      @db.Decimal(10, 2)
  prix         Decimal      @db.Decimal(10, 2)
  total        Decimal      @db.Decimal(10, 2)
  bonLivraison BonLivraison @relation(fields: [blId], references: [id], onDelete: Cascade)
  produit      Produit      @relation(fields: [produitId], references: [id])

  @@map("lignes_bl")
}

model Facture {
  id       Int      @id @default(autoincrement())
  numero   String   @unique
  clientId Int      @map("client_id")
  date     DateTime @default(now())
  total    Decimal  @default(0) @db.Decimal(10, 2)
  paye     Decimal  @default(0) @db.Decimal(10, 2)
  reste    Decimal  @default(0) @db.Decimal(10, 2)
  statut   String   @default("impayée")
  client   Client   @relation(fields: [clientId], references: [id])

  @@map("factures")
}
