generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produit {
  id            Int       @id @default(autoincrement())
  nom           String    @unique
  poidsUnitaire Decimal   @default(1) @db.Decimal(10, 2)
  prixUnitaire  Decimal   @db.Decimal(10, 2)
  quantite      Decimal   @default(0) @db.Decimal(10, 2)
  reference     String    @unique
  unite         String    @default("kg")
  tva           Decimal   @default(0) @db.Decimal(5, 2) // TVA en % (0 = exonéré, 20 = 20%)
  lignesBl      LigneBl[]
  lignesProforma LigneProforma[]
  lignesAvoir   LigneAvoir[]
  mouvements    StockMouvement[]

  @@map("produits")
}

model StockMouvement {
  id          Int      @id @default(autoincrement())
  produitId   Int      @map("produit_id")
  date        DateTime @default(now())
  type        String   // AJUSTEMENT, ENTREE, BL_CREATION, BL_SUPPRESSION
  ancienneQte Decimal  @db.Decimal(10, 2)
  nouvelleQte Decimal  @db.Decimal(10, 2)
  delta       Decimal  @db.Decimal(10, 2)
  motif       String?
  produit     Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)

  @@map("stock_mouvements")
}

model Client {
  id            Int            @id @default(autoincrement())
  nom           String
  telephone     String?
  adresse       String?
  codepostal    String?
  email         String?
  ville         String?
  bonsLivraison BonLivraison[]
  factures      Facture[]
  proformas     FactureProforma[]

  @@map("clients")
}

model BonLivraison {
  id         Int       @id @default(autoincrement())
  numero     String    @unique
  clientId   Int       @map("client_id")
  factureId  Int?      @map("facture_id")
  proformaId Int?      @map("proforma_id")
  date       DateTime  @default(now())
  total      Decimal   @default(0) @db.Decimal(10, 2)
  statut     String    @default("A FACTURER") // A FACTURER, PROFORMA, FACTURÉ
  client     Client    @relation(fields: [clientId], references: [id])
  facture    Facture?  @relation(fields: [factureId], references: [id])
  proforma   FactureProforma? @relation(fields: [proformaId], references: [id])
  lignes     LigneBl[]

  @@map("bons_livraison")
}

model LigneBl {
  id           Int          @id @default(autoincrement())
  blId         Int          @map("bl_id")
  produitId    Int          @map("produit_id")
  nbUnites     Decimal?     @db.Decimal(10, 2) // ex: 3 boules
  poidsUnitaire Decimal?    @db.Decimal(10, 2) // ex: 15.5 kg/boule
  quantite     Decimal      @db.Decimal(10, 2) // Poids total (nbUnites * poidsUnitaire)
  prix         Decimal      @db.Decimal(10, 2) // Prix au kg
  total        Decimal      @db.Decimal(10, 2) // quantite * prix
  bonLivraison BonLivraison @relation(fields: [blId], references: [id], onDelete: Cascade)
  produit      Produit      @relation(fields: [produitId], references: [id])

  @@map("lignes_bl")
}

// ══════ FACTURE PROFORMA ══════
model FactureProforma {
  id            Int            @id @default(autoincrement())
  numero        String         @unique
  clientId      Int            @map("client_id")
  date          DateTime       @default(now())
  totalHT       Decimal        @default(0) @db.Decimal(10, 2)
  totalRemise   Decimal        @default(0) @db.Decimal(10, 2)
  totalTVA      Decimal        @default(0) @db.Decimal(10, 2)
  totalTTC      Decimal        @default(0) @db.Decimal(10, 2)
  statut        String         @default("BROUILLON") // BROUILLON, VALIDÉE, FACTURÉE
  client        Client         @relation(fields: [clientId], references: [id])
  bonsLivraison BonLivraison[]
  lignes        LigneProforma[]
  facture       Facture?

  @@map("factures_proforma")
}

model LigneProforma {
  id                Int             @id @default(autoincrement())
  proformaId        Int             @map("proforma_id")
  produitId         Int             @map("produit_id")
  quantite          Decimal         @db.Decimal(10, 2)
  prix              Decimal         @db.Decimal(10, 2) // prix/kg
  remise            Decimal         @default(0) @db.Decimal(5, 2) // % remise
  tva               Decimal         @default(0) @db.Decimal(5, 2) // % TVA du produit
  totalAvantRemise  Decimal         @db.Decimal(10, 2)
  totalApresRemise  Decimal         @db.Decimal(10, 2)
  totalTVA          Decimal         @default(0) @db.Decimal(10, 2)
  totalTTC          Decimal         @db.Decimal(10, 2)
  proforma          FactureProforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  produit           Produit         @relation(fields: [produitId], references: [id])

  @@map("lignes_proforma")
}

// ══════ FACTURE (mise à jour) ══════
model Facture {
  id            Int            @id @default(autoincrement())
  numero        String         @unique
  clientId      Int            @map("client_id")
  proformaId    Int?           @unique @map("proforma_id")
  date          DateTime       @default(now())
  totalHT       Decimal        @default(0) @db.Decimal(10, 2)
  totalRemise   Decimal        @default(0) @db.Decimal(10, 2)
  totalTVA      Decimal        @default(0) @db.Decimal(10, 2)
  total         Decimal        @default(0) @db.Decimal(10, 2) // TTC
  paye          Decimal        @default(0) @db.Decimal(10, 2)
  reste         Decimal        @default(0) @db.Decimal(10, 2)
  statut        String         @default("impayée")
  client        Client         @relation(fields: [clientId], references: [id])
  proforma      FactureProforma? @relation(fields: [proformaId], references: [id])
  bonsLivraison BonLivraison[]
  avoirs        FactureAvoir[]
  paiements     Paiement[]

  @@map("factures")
}

// ══════ FACTURE D'AVOIR ══════
model FactureAvoir {
  id         Int          @id @default(autoincrement())
  numero     String       @unique
  factureId  Int          @map("facture_id")
  date       DateTime     @default(now())
  total      Decimal      @default(0) @db.Decimal(10, 2)
  motif      String?
  facture    Facture      @relation(fields: [factureId], references: [id])
  lignes     LigneAvoir[]

  @@map("factures_avoir")
}

model LigneAvoir {
  id            Int          @id @default(autoincrement())
  avoirId       Int          @map("avoir_id")
  produitId     Int          @map("produit_id")
  nbUnites      Decimal?     @db.Decimal(10, 2)
  poidsUnitaire Decimal?     @db.Decimal(10, 2)
  quantite      Decimal      @db.Decimal(10, 2)
  prix          Decimal      @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  avoir         FactureAvoir @relation(fields: [avoirId], references: [id], onDelete: Cascade)
  produit       Produit      @relation(fields: [produitId], references: [id])

  @@map("lignes_avoir")
}

model Paiement {
  id          Int      @id @default(autoincrement())
  factureId   Int      @map("facture_id")
  montant     Decimal  @db.Decimal(10, 2)
  methode     String   // ESPECE, CHEQUE, VIREMENT
  date        DateTime @default(now())
  remarque    String?
  facture     Facture  @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@map("paiements")
}
