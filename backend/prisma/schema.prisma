generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produit {
  id            Int       @id @default(autoincrement())
  reference     String    @unique
  nom           String    @unique
  unite         String    @default("kg")
  poidsUnitaire Decimal   @default(1) @db.Decimal(10, 2)
  quantite      Int       @default(0)
  prixUnitaire  Decimal   @db.Decimal(10, 2)
  lignesBl      LigneBl[]

  @@map("produits")
}

model Client {
  id            Int            @id @default(autoincrement())
  nom           String
  ice           String?         
  telephone     String?
  adresse       String?
  email         String?
  ville         String?
  codepostal    String?
  bonsLivraison BonLivraison[]
  factures      Facture[]
 
  @@map("clients")
}

model BonLivraison {
  id       Int       @id @default(autoincrement())
  numero   String    @unique
  clientId Int       @map("client_id")
  date     DateTime  @default(now())
  total    Decimal   @default(0) @db.Decimal(10, 2)
  client   Client    @relation(fields: [clientId], references: [id])
  lignes   LigneBl[]

  @@map("bons_livraison")
}

model LigneBl {
  id           Int          @id @default(autoincrement())
  blId         Int          @map("bl_id")
  produitId    Int          @map("produit_id")
  quantite     Decimal      @db.Decimal(10, 2)
  prix         Decimal      @db.Decimal(10, 2)
  total        Decimal      @db.Decimal(10, 2)
  bonLivraison BonLivraison @relation(fields: [blId], references: [id], onDelete: Cascade)
  produit      Produit      @relation(fields: [produitId], references: [id])

  @@map("lignes_bl")
}

model Facture {
  id       Int      @id @default(autoincrement())
  numero   String   @unique
  clientId Int      @map("client_id")
  date     DateTime @default(now())
  total    Decimal  @default(0) @db.Decimal(10, 2)
  paye     Decimal  @default(0) @db.Decimal(10, 2)
  reste    Decimal  @default(0) @db.Decimal(10, 2)
  statut   String   @default("impayée")
  client   Client   @relation(fields: [clientId], references: [id])

  @@map("factures")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  logs     ActivityLog[]
  @@map("users")
}
model ActivityLog {
  id     Int   @id @default(autoincrement())
  action String 
  entity String
  entityId Int
  description String?
  userId   Int
  user   User   @relation(fields: [userId], references:[id])
  createdAt  DateTime @default(now())

  @@map("activitylog")
}